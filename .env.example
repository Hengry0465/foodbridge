APP_NAME=FoodBridge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodbridge
DB_USERNAME=root
DB_PASSWORD=

BCRYPT_ROUNDS=12

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Pickup Scheduling & Tracking module (see README_PICKUP_MODULE.md)
PICKUP_SLOT_DURATION=60
PICKUP_EXPIRY_HOURS=2
